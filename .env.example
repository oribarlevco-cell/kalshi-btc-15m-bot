# Kalshi environment: "demo" or "prod". Market data endpoints are public in
# both, so this bot runs fine with no keys set at all.
KALSHI_ENV=demo

# Optional: only needed for authenticated endpoints (not required for market
# data polling). Generate via https://docs.kalshi.com/getting_started/api_keys
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# Bot behavior
POLL_INTERVAL_SECONDS=20
DB_PATH=data/kalshi_btc15m.db
SERIES_TICKER=KXBTC15M

# --- Prediction model (used by --predict and --trade) ---
PRICE_FEED_URL=https://api.exchange.coinbase.com/products/BTC-USD/ticker
MIN_SAMPLES_FOR_PREDICTION=5
# Only act on predictions this far from a coinflip (0=coinflip, 1=certain)
MIN_SIGNAL_CONFIDENCE=0.15
# Lookback window for the momentum signal (logged, not used by the formula)
MOMENTUM_WINDOW_SECONDS=300

# --- Paper trading (used by --trade only) ---
# Must be "true" AND KALSHI_ENV=demo AND API credentials set above for
# --trade to do anything. This build never places prod/real-money orders --
# KALSHI_ENV=prod hard-disables --trade regardless of this flag.
TRADING_ENABLED=false
MAX_ORDER_COST_DOLLARS=5.0
# Only propose a trade when time remaining in the 15-min window is in this
# range (avoids the noisy first minute and the illiquid last minute)
TRADE_WINDOW_MIN_SECONDS=60
TRADE_WINDOW_MAX_SECONDS=780

# --- Local DB backups (see README > Backups) ---
BACKUP_DIR=data/backups
BACKUP_INTERVAL_HOURS=24

# --- Live dashboard server (used by `python -m src.live_server` only) ---
# Generate a token with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Required to start the server at all -- there is no default.
LIVE_SERVER_TOKEN=
LIVE_SERVER_PORT=8899
# Your GitHub Pages origin (scheme+host only, no path) -- CORS is locked to this.
LIVE_SERVER_ALLOWED_ORIGIN=https://oribarlevco-cell.github.io
LIVE_SERVER_REFRESH_SECONDS=15
CALIBRATION_SNAPSHOT_INTERVAL_MINUTES=15

# --- Automated multi-strategy paper trading (used by `python -m src.multi_trader` only) ---
# Separate, explicit opt-in from TRADING_ENABLED -- places orders for
# momentum/favorite/agreement automatically, with NO per-trade confirmation.
# Still requires KALSHI_ENV=demo and credentials; prod is always hard-blocked.
# Paper/demo money only.
MULTI_STRATEGY_TRADING_ENABLED=false
# Position-size tiers: a strategy's stake only increases once its OWN
# backtested win rate has a 95%-Wilson-CI lower bound above a coinflip.
STRATEGY_TIER1_MIN_N=20
STRATEGY_TIER1_MIN_CI_LOWER=0.50
STRATEGY_TIER1_MULTIPLIER=2
STRATEGY_TIER2_MIN_N=50
STRATEGY_TIER2_MIN_CI_LOWER=0.55
STRATEGY_TIER2_MULTIPLIER=4
MULTI_STRATEGY_MAX_CONCURRENT_POSITIONS=5
