# Kalshi environment: "demo" or "prod". Market data endpoints are public in
# both, so this bot runs fine with no keys set at all.
KALSHI_ENV=demo

# Optional: only needed for authenticated endpoints (not required for market
# data polling). Generate via https://docs.kalshi.com/getting_started/api_keys
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# Bot behavior
POLL_INTERVAL_SECONDS=20
DB_PATH=data/kalshi_btc15m.db
SERIES_TICKER=KXBTC15M
