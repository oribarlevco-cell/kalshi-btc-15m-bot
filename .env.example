# Kalshi environment: "demo" or "prod". Market data endpoints are public in
# both, so this bot runs fine with no keys set at all.
KALSHI_ENV=demo

# Optional: only needed for authenticated endpoints (not required for market
# data polling). Generate via https://docs.kalshi.com/getting_started/api_keys
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem

# Bot behavior
POLL_INTERVAL_SECONDS=20
DB_PATH=data/kalshi_btc15m.db
SERIES_TICKER=KXBTC15M

# --- Prediction model (used by --predict and --trade) ---
PRICE_FEED_URL=https://api.exchange.coinbase.com/products/BTC-USD/ticker
MIN_SAMPLES_FOR_PREDICTION=5
# Only act on predictions this far from a coinflip (0=coinflip, 1=certain)
MIN_SIGNAL_CONFIDENCE=0.15

# --- Paper trading (used by --trade only) ---
# Must be "true" AND KALSHI_ENV=demo AND API credentials set above for
# --trade to do anything. This build never places prod/real-money orders --
# KALSHI_ENV=prod hard-disables --trade regardless of this flag.
TRADING_ENABLED=false
MAX_ORDER_COST_DOLLARS=5.0
# Only propose a trade when time remaining in the 15-min window is in this
# range (avoids the noisy first minute and the illiquid last minute)
TRADE_WINDOW_MIN_SECONDS=60
TRADE_WINDOW_MAX_SECONDS=780
